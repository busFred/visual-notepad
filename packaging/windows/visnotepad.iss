; Inno Setup script for Visual Notepad. Build with:
;   iscc /DAppVersion=0.0.13 /DSourceDir=<deployed folder> /DOutputDir=<dir> visnotepad.iss
#ifndef AppVersion
  #define AppVersion "0.0.13"
#endif
#ifndef SourceDir
  #error SourceDir must point at the deployed application folder
#endif
#ifndef OutputDir
  #define OutputDir "."
#endif

[Setup]
AppId={{6B0D3E1E-4C0B-4C3A-9D5C-5E1B7B8E2A71}
AppName=Visual Notepad
AppVersion={#AppVersion}
AppPublisher=Hung-Tien Huang
AppPublisherURL=https://github.com/busFred/visual-notepad
AppSupportURL=https://github.com/busFred/visual-notepad/issues
DefaultDirName={autopf}\Visual Notepad
DefaultGroupName=Visual Notepad
DisableProgramGroupPage=yes
LicenseFile={#SourceDir}\licenses\LICENSE
SetupIconFile=visnotepad.ico
UninstallDisplayIcon={app}\visnotepad.exe
UninstallDisplayName=Visual Notepad
OutputDir={#OutputDir}
OutputBaseFilename=visnotepad-{#AppVersion}-windows-x64-setup
Compression=lzma2/max
SolidCompression=yes
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
; Per-user by default; the wizard offers an all-users install.
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
WizardStyle=modern
; Explorer reads the file types again after install and uninstall.
ChangesAssociations=yes

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

; The file types to offer Visual Notepad for, ticked per type or per group
; (generated by make_associations.py, which says what each adds).
#include "associations.iss"

[Registry]
; Visual Notepad as an application: "Open with" names it, and Settings >
; Default apps lists it with the file types ticked (associations.iss).
; https://learn.microsoft.com/windows/win32/shell/app-registration
; https://learn.microsoft.com/windows/win32/shell/default-programs
Root: HKA; Subkey: "Software\Classes\Applications\visnotepad.exe"; ValueType: string; ValueName: "FriendlyAppName"; ValueData: "Visual Notepad"; Flags: uninsdeletekey
Root: HKA; Subkey: "Software\Classes\Applications\visnotepad.exe\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\visnotepad.exe"" ""%1"""
Root: HKA; Subkey: "Software\Visual Notepad"; Flags: uninsdeletekeyifempty
Root: HKA; Subkey: "Software\Visual Notepad\Capabilities"; ValueType: string; ValueName: "ApplicationName"; ValueData: "Visual Notepad"; Flags: uninsdeletekey
Root: HKA; Subkey: "Software\Visual Notepad\Capabilities"; ValueType: string; ValueName: "ApplicationDescription"; ValueData: "A notepad with Markdown editing and preview."
Root: HKA; Subkey: "Software\RegisteredApplications"; ValueType: string; ValueName: "Visual Notepad"; ValueData: "Software\Visual Notepad\Capabilities"; Flags: uninsdeletevalue

[Files]
Source: "{#SourceDir}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{autoprograms}\Visual Notepad"; Filename: "{app}\visnotepad.exe"
Name: "{autodesktop}\Visual Notepad"; Filename: "{app}\visnotepad.exe"; Tasks: desktopicon

[Run]
; Offered, not ticked.
Filename: "{app}\visnotepad.exe"; Description: "{cm:LaunchProgram,Visual Notepad}"; Flags: nowait postinstall skipifsilent unchecked
; Only Windows sets a default app (since Windows 10). Windows 11 opens
; Visual Notepad's own page there; earlier versions, the Default apps page.
; https://learn.microsoft.com/windows/apps/develop/launch/launch-default-apps-settings
Filename: "ms-settings:defaultapps?registeredAppUser=Visual%20Notepad"; Description: "Open Windows Settings to make Visual Notepad the default for some of these types"; Flags: nowait postinstall shellexec skipifsilent unchecked; Tasks: assoc; Check: not IsAdminInstallMode
Filename: "ms-settings:defaultapps?registeredAppMachine=Visual%20Notepad"; Description: "Open Windows Settings to make Visual Notepad the default for some of these types"; Flags: nowait postinstall shellexec skipifsilent unchecked; Tasks: assoc; Check: IsAdminInstallMode
